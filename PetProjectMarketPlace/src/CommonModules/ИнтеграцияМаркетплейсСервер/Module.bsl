// @strict-types
#Область ПрограммныйИнтерфейс

Функция ИзменитьСтатусЗаказа(Запрос) Экспорт
	НомерЗаказа = Запрос.ПараметрыURL.Получить("orderId");
	Если ТипЗнч(НомерЗаказа) <> Тип("Строка") Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Ожидается корректный OrderId."));
	КонецЕсли;
	НомерЗаказа = СокрЛП(НомерЗаказа);

	Данные = ПрочитатьТелоJSON(Запрос);
	Статус = Данные.Получить("status");
	Если Статус = "delivered" Тогда
		Статус = Перечисления.СтатусыЗаказа.Доставлен;
	ИначеЕсли Статус = "cancelled" Тогда
		Статус = Перечисления.СтатусыЗаказа.Отменен;
	Иначе
		Возврат ОтветJSON(400, Новый Структура("error", "Ожидается корректный Status."));
	КонецЕсли;

	ЗапросБД = Новый Запрос;
	ЗапросБД.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	ЗаказМаркетплейса.Ссылка КАК Ссылка
				   |ИЗ
				   |	Документ.ЗаказМаркетплейса КАК ЗаказМаркетплейса
				   |ГДЕ
				   |	ЗаказМаркетплейса.НомерЗаказаМП = &НомерЗаказаМП
				   |	И НЕ ЗаказМаркетплейса.ПометкаУдаления";
	ЗапросБД.УстановитьПараметр("НомерЗаказаМП", НомерЗаказа);
	
	Выборка = ЗапросБД.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Не найден заказ"));
	КонецЕсли;
	
	ДокументОбъект = Выборка.Ссылка.ПолучитьОбъект();
	
	ДокументОбъект.Статус = Статус;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат ОтветJSON(200, Новый Структура("ok", "Успешно"));
	
	
КонецФункции

Функция СоздатьЗаказ(Запрос) Экспорт

	Данные = ПрочитатьТелоJSON(Запрос);
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Ожидается корректный JSON-объект."));
	КонецЕсли;

	НомерЗаказаМП = Данные.Получить("orderId");
	Если ТипЗнч(НомерЗаказаМП) <> Тип("Строка") Или Не ЗначениеЗаполнено(НомерЗаказаМП) Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Некорректное поле orderId."));
	КонецЕсли;
	НомерЗаказаМП = СокрЛП(НомерЗаказаМП);

	ИННМаркетплейса = Данные.Получить("marketplaceInn");
	Если ТипЗнч(ИННМаркетплейса) <> Тип("Строка") Или Не ЗначениеЗаполнено(ИННМаркетплейса) Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Некорректное поле marketplaceInn."));
	КонецЕсли;
	ИННМаркетплейса = СокрЛП(ИННМаркетплейса);

	Позиции = Данные.Получить("items");
	Если ТипЗнч(Позиции) <> Тип("Массив") Или Позиции.Количество() = 0 Тогда
		Возврат ОтветJSON(400, Новый Структура("error", "Поле items должно быть непустым массивом."));
	КонецЕсли;

	ТоварыПоАртикулам = Новый Соответствие;
	Артикулы = Новый Массив;
	Для Каждого СтрокаТовара Из Позиции Цикл
		Если ТипЗнч(СтрокаТовара) <> Тип("Соответствие") Тогда
			Возврат ОтветJSON(400, Новый Структура("error", "Некорректный элемент в items."));
		КонецЕсли;

		Артикул = СтрокаТовара.Получить("sku");
		Количество = СтрокаТовара.Получить("qty");
		Если ТипЗнч(Артикул) <> Тип("Строка") Или Не ЗначениеЗаполнено(Артикул) Или ТипЗнч(Количество) <> Тип("Число")
			Или Количество <= 0 Тогда
			Возврат ОтветJSON(400, Новый Структура("error", "Некорректные sku или qty в items."));
		КонецЕсли;

		Артикул = СокрЛП(Артикул);
		ТекущееКоличество = ТоварыПоАртикулам.Получить(Артикул);
		Если ТипЗнч(ТекущееКоличество) = Тип("Число") Тогда
			ТоварыПоАртикулам.Вставить(Артикул, ТекущееКоличество + Количество);
		Иначе
			ТоварыПоАртикулам.Вставить(Артикул, Количество);
			Артикулы.Добавить(Артикул);
		КонецЕсли;
	КонецЦикла;

	ЗапросДубля = Новый Запрос;
	ЗапросДубля.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Заказ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЗаказМаркетплейса КАК Заказ
	|ГДЕ
	|	Заказ.НомерЗаказаМП = &НомерЗаказаМП
	|	И НЕ Заказ.ПометкаУдаления";
	ЗапросДубля.УстановитьПараметр("НомерЗаказаМП", НомерЗаказаМП);
	Если Не ЗапросДубля.Выполнить().Пустой() Тогда
		Возврат ОтветJSON(409, Новый Структура("error", "Заказ уже существует."));
	КонецЕсли;

	Маркетплейс = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН", ИННМаркетплейса);
	Если Маркетплейс.Пустая() Или Маркетплейс.ПометкаУдаления Или Не Маркетплейс.ЭтоМаркетплейс Тогда
		Возврат ОтветJSON(404, Новый Структура("error", "Маркетплейс не найден."));
	КонецЕсли;

	ДатаЗаказа = ТекущаяДатаСеанса();
	ТоварыБазы = НайтиТоварыИЦены(Артикулы, ДатаЗаказа);

	ДокументОбъект = Документы.ЗаказМаркетплейса.СоздатьДокумент();
	ДокументОбъект.Дата = ДатаЗаказа;
	ДокументОбъект.НомерЗаказаМП = НомерЗаказаМП;
	ДокументОбъект.Маркетплейс = Маркетплейс;
	ДокументОбъект.Статус = Перечисления.СтатусыЗаказа.ОжидаетСборки;

	ИтогоСумма = 0;
	Для Каждого Элемент Из ТоварыПоАртикулам Цикл
		Товар = ТоварыБазы.Получить(Элемент.Ключ);
		Если ТипЗнч(Товар) <> Тип("Структура") Тогда
			Возврат ОтветJSON(404, Новый Структура("error", "Не найден артикул: " + Строка(Элемент.Ключ)));
		КонецЕсли;

		СтрокаТЧ = ДокументОбъект.Товары.Добавить();
		СтрокаТЧ.Номенклатура = Товар.Номенклатура;
		СтрокаТЧ.Количество = Элемент.Значение;
		СтрокаТЧ.Цена = Товар.Цена;
		СтрокаТЧ.Сумма = СтрокаТЧ.Количество * СтрокаТЧ.Цена;
		СтрокаТЧ.ПроцентКомиссии = Товар.ПроцентКомиссии;
		СтрокаТЧ.СуммаКомиссии = Окр(СтрокаТЧ.Сумма * СтрокаТЧ.ПроцентКомиссии / 100, 2);

		ИтогоСумма = ИтогоСумма + СтрокаТЧ.Сумма;
	КонецЦикла;

	ДокументОбъект.СуммаЗаказа = ИтогоСумма;

	ПолучитьСообщенияПользователю(Истина);

	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Сообщения = ПолучитьСообщенияПользователю(Истина);
		Если Сообщения.Количество() > 0 Тогда
			ТекстОшибки = "";
			Для Каждого Сообщение Из Сообщения Цикл
				ТекстОшибки = ТекстОшибки + Сообщение.Текст + " ";
			КонецЦикла;
			Возврат ОтветJSON(422, Новый Структура("error", СокрЛП(ТекстОшибки)));
		КонецЕсли;
		Возврат ОтветJSON(500, Новый Структура("error", КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

	ТелоОтвета = Новый Структура("ok, orderId, documentNumber, documentId, status", Истина, НомерЗаказаМП, Строка(
		ДокументОбъект.Номер), Строка(ДокументОбъект.Ссылка.УникальныйИдентификатор()), "awaiting_assembly");

	Возврат ОтветJSON(201, ТелоОтвета);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиТоварыИЦены(Артикулы, ДатаЗаказа)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.Ссылка КАК Номенклатура,
	|	Номенклатура.Артикул КАК Артикул
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Артикул В (&Артикулы)
	|	И НЕ Номенклатура.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|ВЫБРАТЬ
	|	ВТ_Номенклатура.Номенклатура КАК Номенклатура,
	|	ВТ_Номенклатура.Артикул КАК Артикул,
	|	ЕСТЬNULL(Цены.ЦенаПродажи, 0) КАК Цена,
	|	ЕСТЬNULL(Цены.ПроцентКомиссии, 0) КАК ПроцентКомиссии
	|ИЗ
	|	ВТ_Номенклатура КАК ВТ_Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныМаркетплейса.СрезПоследних(
	|			&ДатаЗаказа,
	|			Номенклатура В (ВЫБРАТЬ ВТ.Номенклатура ИЗ ВТ_Номенклатура КАК ВТ)) КАК Цены
	|		ПО ВТ_Номенклатура.Номенклатура = Цены.Номенклатура";
	Запрос.УстановитьПараметр("ДатаЗаказа", ДатаЗаказа);
	Запрос.УстановитьПараметр("Артикулы", Артикулы);

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Товар = Новый Структура("Номенклатура, Цена, ПроцентКомиссии", Выборка.Номенклатура, Выборка.Цена,
			Выборка.ПроцентКомиссии);
		Результат.Вставить(СокрЛП(Выборка.Артикул), Товар);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОтветJSON(КодСостояния, Данные)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	ТекстJSON = Запись.Закрыть();

	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Если ТекстJSON <> Неопределено Тогда
		Ответ.УстановитьТелоИзСтроки(
			ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Возврат Ответ;

КонецФункции

Функция ПрочитатьТелоJSON(Запрос)

	ТелоСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ТелоСтрока = Неопределено Или ПустаяСтрока(ТелоСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТелоСтрока);

	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		Возврат Неопределено;
	КонецПопытки;

	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

#КонецОбласти