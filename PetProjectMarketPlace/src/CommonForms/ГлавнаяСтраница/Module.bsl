// @strict-types
#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы
&НаКлиенте
Процедура ВыгрузитьОстаткиИЦены()
	ВыгрузитьОстаткиИЦеныНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыгрузитьОстаткиИЦеныНаСервере()
	Результат = ИнтеграцияМаркетплейсСервер.ВыгрузитьОстаткиИЦены();
	Сообщение = Новый СообщениеПользователю;
	Если Результат.Ок Тогда
		Сообщение.Текст = "Выгрузка успешна: " + Строка(Результат.Сообщение);
	Иначе
		Сообщение.Текст = "Ошибка (" + Строка(Результат.КодСостояния) + "): " + Строка(Результат.Сообщение);
	КонецЕсли;
	Сообщение.Сообщить();
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СформироватьHTML();
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы
&НаКлиенте
Процедура ТекстHTMLПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Если ДанныеСобытия.Element = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИдКнопки = ДанныеСобытия.Element.id;

	Если ИдКнопки = "btn-new-order" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Документ.ЗаказМаркетплейса.ФормаОбъекта");
	ИначеЕсли ИдКнопки = "btn-orders" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФорму("Документ.ЗаказМаркетплейса.ФормаСписка");
	ИначеЕсли ИдКнопки = "btn-refresh" Тогда
		СтандартнаяОбработка = Ложь;
		СформироватьHTML();
	ИначеЕсли ИдКнопки = "btn-upload" Тогда
		СтандартнаяОбработка = Ложь;
		ВыгрузитьОстаткиИЦены();
	КонецЕсли;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура СформироватьHTML()
	Макет = ПолучитьОбщийМакет("ГлавнаяСтраницаHTML");
	ШаблонHTML = Макет.ПолучитьТекст();

	ДанныеДашборда = ПолучитьДанныеДашборда();
	СтрокаJSON = СериализоватьВJSON(ДанныеДашборда);

	ТекстHTML = СтрЗаменить(ШаблонHTML, "_STATE_", СтрокаJSON);
КонецПроцедуры
&НаСервере
Функция ПолучитьДанныеДашборда()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	КОЛИЧЕСТВО(ЗаказМаркетплейса.Ссылка) КАК КоличествоЗаказов,
				   |	ЕСТЬNULL(СУММА(ЗаказМаркетплейса.СуммаЗаказа), 0) КАК ОбщаяСумма
				   |ИЗ
				   |	Документ.ЗаказМаркетплейса КАК ЗаказМаркетплейса
				   |ГДЕ
				   |	НЕ ЗаказМаркетплейса.ПометкаУдаления";

	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();

	Результат = Новый Структура;
	Результат.Вставить("ordersCount", Выборка.КоличествоЗаказов);
	Результат.Вставить("totalSum", Выборка.ОбщаяСумма);
	Возврат Результат;
КонецФункции
&НаСервере
Функция СериализоватьВJSON(Данные)
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции
&НаСервере
Процедура ТекстHTMLПриНажатииНаСервере()
	СформироватьHTML();
КонецПроцедуры
#КонецОбласти