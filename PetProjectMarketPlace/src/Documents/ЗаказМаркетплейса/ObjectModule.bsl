#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.Продажи.Записывать = Истина;
	Движения.ВзаиморасчетыСМаркетплейсами.Записывать = Истина;
	Движения.РезервыТоваров.Записывать = Истина;
	Движения.ТоварыНаСкладах.Записывать = Истина;

	Если Статус = Перечисления.СтатусыЗаказа.ОжидаетСборки Тогда
		ПровестиОжидаетСборки(Отказ);
	ИначеЕсли Статус = Перечисления.СтатусыЗаказа.Доставлен Тогда
		ПровестиДоставлен(Отказ);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПровестиОжидаетСборки(Отказ)
	ОстаткиТоваров = ПолучитьДоступныеОстатки();

	Для Каждого Элемент Из Товары Цикл
		Доступно = ОстаткиТоваров.Получить(Элемент.Номенклатура);
		Если Доступно = Неопределено Тогда
			Доступно = 0;
		КонецЕсли;

		Если Доступно < Элемент.Количество Тогда
			Отказ = Истина;
			СообщитьОбОшибке("Не хватает остатков для резерва по товару: " + Элемент.Номенклатура);
			Возврат;
		КонецЕсли;

		Движение = Движения.РезервыТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Номенклатура = Элемент.Номенклатура;
		Движение.Количество = Элемент.Количество;
	КонецЦикла;
КонецПроцедуры

Процедура ПровестиДоставлен(Отказ)
	ТЗПартий = ПолучитьПартииТоваров();

	Для Каждого Элемент Из Товары Цикл
		СебестоимостьСтроки = СписатьТоварПоФИФО(Элемент, ТЗПартий, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;

		ОтразитьПродажу(Элемент, СебестоимостьСтроки);
	КонецЦикла;

	ОтразитьВзаиморасчеты();
КонецПроцедуры

Функция СписатьТоварПоФИФО(Элемент, ТЗПартий, Отказ)
	ПартииТовара = ТЗПартий.НайтиСтроки(Новый Структура("Номенклатура", Элемент.Номенклатура));
	ОсталосьСписать = Элемент.Количество;
	СебестоимостьСтроки = 0;

	Для Каждого СтрокаПартии Из ПартииТовара Цикл
		Списать = Мин(ОсталосьСписать, СтрокаПартии.КоличествоОстаток);

		Если Списать = СтрокаПартии.КоличествоОстаток Тогда
			СтоимостьСписания = СтрокаПартии.СтоимостьОстаток;
		Иначе
			СтоимостьСписания = СтрокаПартии.СтоимостьОстаток / СтрокаПартии.КоличествоОстаток * Списать;
		КонецЕсли;

		Движение = Движения.ТоварыНаСкладах.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Номенклатура = Элемент.Номенклатура;
		Движение.Партия = СтрокаПартии.Партия;
		Движение.Количество = Списать;
		Движение.Стоимость = СтоимостьСписания;

		ОсталосьСписать = ОсталосьСписать - Списать;
		СебестоимостьСтроки = СебестоимостьСтроки + СтоимостьСписания;

		Если ОсталосьСписать = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если ОсталосьСписать > 0 Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не хватает физических остатков по товару: " + Элемент.Номенклатура);
		Возврат 0;
	КонецЕсли;

	Возврат СебестоимостьСтроки;
КонецФункции

Процедура ОтразитьПродажу(Элемент, Себестоимость)
	Движение = Движения.Продажи.Добавить();
	Движение.Период = Дата;
	Движение.Маркетплейс = Маркетплейс;
	Движение.Номенклатура = Элемент.Номенклатура;
	Движение.Количество = Элемент.Количество;
	Движение.Выручка = Элемент.Сумма;
	Движение.СуммаКомиссии = Элемент.СуммаКомиссии;
	Движение.Себестоимость = Себестоимость;
КонецПроцедуры

Процедура ОтразитьВзаиморасчеты()
	Движение = Движения.ВзаиморасчетыСМаркетплейсами.Добавить();
	Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
	Движение.Период = Дата;
	Движение.Маркетплейс = Маркетплейс;
	Движение.Сумма = Товары.Итог("Сумма") - Товары.Итог("СуммаКомиссии");
КонецПроцедуры

Функция ПолучитьДоступныеОстатки()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток - ЕСТЬNULL(РезервыТоваровОстатки.КоличествоОстаток, 0) КАК Доступно
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&МоментВремени, Номенклатура В (&СписокНоменклатуры)) КАК ТоварыНаСкладахОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.РезервыТоваров.Остатки(&МоментВремени, Номенклатура В (&СписокНоменклатуры)) КАК РезервыТоваровОстатки
	|		ПО ТоварыНаСкладахОстатки.Номенклатура = РезервыТоваровОстатки.Номенклатура";

	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("СписокНоменклатуры", Товары.ВыгрузитьКолонку("Номенклатура"));

	ОстаткиТоваров = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОстаткиТоваров.Вставить(Выборка.Номенклатура, Выборка.Доступно);
	КонецЦикла;

	Возврат ОстаткиТоваров;
КонецФункции

Функция ПолучитьПартииТоваров()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТоварыНаСкладахОстатки.Номенклатура КАК Номенклатура,
	|	ТоварыНаСкладахОстатки.Партия КАК Партия,
	|	ТоварыНаСкладахОстатки.СтоимостьОстаток КАК СтоимостьОстаток,
	|	ТоварыНаСкладахОстатки.Партия.Дата КАК ПартияДата,
	|	ТоварыНаСкладахОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ТоварыНаСкладах.Остатки(&МоментВремени, Номенклатура В (&СписокНоменклатуры)) КАК ТоварыНаСкладахОстатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПартияДата";

	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("СписокНоменклатуры", Товары.ВыгрузитьКолонку("Номенклатура"));

	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура СообщитьОбОшибке(ТекстОшибки)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = ТекстОшибки;
	Сообщение.Сообщить();
КонецПроцедуры

