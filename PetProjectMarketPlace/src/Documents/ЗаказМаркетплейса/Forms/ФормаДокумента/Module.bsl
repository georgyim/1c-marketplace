#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = ПолучитьТекущуюСтроку();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеТовара = ТоварыНоменклатураПриИзмененииНаСервере(ТекущаяСтрока.Номенклатура, Объект.Дата);
	Если ДанныеТовара.Количество() = 0 Тогда
		ТекущаяСтрока.Сумма = Неопределено;
		ТекущаяСтрока.СуммаКомиссии = Неопределено;
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.ПроцентКомиссии = ДанныеТовара.ПроцентКомиссии;
	ТекущаяСтрока.Цена = ДанныеТовара.ЦенаПродажи;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ДанныеТовара.ЦенаПродажи;
	ТекущаяСтрока.СуммаКомиссии = ТекущаяСтрока.Сумма * (ДанныеТовара.ПроцентКомиссии / 100);
	ОбщиеСуммы = ВысчитатьОбщиеСуммы();
	Объект.СуммаЗаказа = ОбщиеСуммы.ОбщаяСумма;
	Объект.СуммаКомиссии = ОбщиеСуммы.ОбщаяСуммаКомиссии;
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	ТекущаяСтрока = ПолучитьТекущуюСтроку();
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если ТекущаяСтрока.Количество = 0 Или ТекущаяСтрока.Цена = 0 Или ТекущаяСтрока.Цена = Неопределено Тогда
		Сообщить("Товар не найден");
		ТекущаяСтрока.Сумма = Неопределено;
		ТекущаяСтрока.СуммаКомиссии = Неопределено;
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
	ТекущаяСтрока.СуммаКомиссии = ТекущаяСтрока.Сумма * (ТекущаяСтрока.ПроцентКомиссии / 100);
	ОбщиеСуммы = ВысчитатьОбщиеСуммы();
	Объект.СуммаЗаказа = ОбщиеСуммы.ОбщаяСумма;
	Объект.СуммаКомиссии = ОбщиеСуммы.ОбщаяСуммаКомиссии;
КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервереБезКонтекста
Функция ТоварыНоменклатураПриИзмененииНаСервере(НоменклатураСсылка, ДатаПереданная)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	ЦеныМаркетплейсаСрезПоследних.ЦенаПродажи КАК ЦенаПродажи,
				   |	ЦеныМаркетплейсаСрезПоследних.ПроцентКомиссии КАК ПроцентКомиссии
				   |ИЗ
				   |	РегистрСведений.ЦеныМаркетплейса.СрезПоследних(&Дата, Номенклатура = &Номенклатура) КАК ЦеныМаркетплейсаСрезПоследних";

	Запрос.УстановитьПараметр("Номенклатура", НоменклатураСсылка);
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Сообщить("Выборка пустая");
		Возврат Новый Структура;
	КонецЕсли;
	СтруктураТовара = Новый Структура;
	СтруктураТовара.Вставить("ЦенаПродажи", Выборка["ЦенаПродажи"]);
	СтруктураТовара.Вставить("ПроцентКомиссии", Выборка["ПроцентКомиссии"]);
	Возврат СтруктураТовара;
КонецФункции
&НаКлиенте
Функция ПолучитьТекущуюСтроку()
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;

	Если ТекущаяСтрока = Неопределено Тогда
		Сообщить("Текущая строка неопределена");
		Возврат Неопределено;
	КонецЕсли;

	Возврат ТекущаяСтрока;
КонецФункции
// Возвращаемое значение:
//   Структура:
//     * ОбщаяСумма - Число
//     * ОбщаяСуммаКомиссии - Число
//
&НаКлиенте
Функция ВысчитатьОбщиеСуммы()
	ОбщаяСумма = 0;
	ОбщаяСуммаКомиссии = 0;
	Для Каждого Элемент Из Объект.Товары Цикл
		ОбщаяСумма = Элемент.Сумма + ОбщаяСумма;
		ОбщаяСуммаКомиссии = Элемент.СуммаКомиссии + ОбщаяСуммаКомиссии;
	КонецЦикла;

	Возврат Новый Структура("ОбщаяСумма,ОбщаяСуммаКомиссии", ОбщаяСумма, ОбщаяСуммаКомиссии)
КонецФункции
#КонецОбласти