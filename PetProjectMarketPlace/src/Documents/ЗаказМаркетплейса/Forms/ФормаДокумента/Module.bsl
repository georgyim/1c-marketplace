#КонецОбласти
#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары
&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.Товары.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ДанныеТовара = ТоварыНоменклатураПриИзмененииНаСервере( ТекущаяСтрока.Номенклатура.Наименование);
	Если ДанныеТовара.Количество() = 0 Тогда
		Сообщить("Товар не найден");
		ТекущаяСтрока.Сумма = Неопределено;
		ТекущаяСтрока.СуммаКомиссии = Неопределено;
		Возврат;
	КонецЕсли;
	ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ДанныеТовара.ЦенаПродажи;
	ТекущаяСтрока.СуммаКомиссии = ТекущаяСтрока.Сумма * (ДанныеТовара.ПроцентКомиссии / 100);

КонецПроцедуры
#КонецОбласти
#Область ОбработчикиКомандФормы

// Код процедур и функций

#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаСервереБезКонтекста
Функция ТоварыНоменклатураПриИзмененииНаСервере(Наименование)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
				   |	УстановкаЦенМаркетплейсаТовары.ЦенаПродажи КАК ЦенаПродажи,
				   |	УстановкаЦенМаркетплейсаТовары.ПроцентКомиссии КАК ПроцентКомиссии,
				   |	УстановкаЦенМаркетплейса.Дата КАК Дата,
				   |	УстановкаЦенМаркетплейсаТовары.Номенклатура.Наименование КАК НоменклатураНаименование
				   |ИЗ
				   |	Документ.УстановкаЦенМаркетплейса.Товары КАК УстановкаЦенМаркетплейсаТовары
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.УстановкаЦенМаркетплейса КАК УстановкаЦенМаркетплейса
				   |		ПО УстановкаЦенМаркетплейсаТовары.Ссылка = УстановкаЦенМаркетплейса.Ссылка
				   |ГДЕ
				   |	УстановкаЦенМаркетплейсаТовары.Номенклатура.Наименование = &Наименование
				   |
				   |УПОРЯДОЧИТЬ ПО
				   |	Дата УБЫВ";

	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Сообщить("Выборка пустая");
		Возврат Новый Структура;
	КонецЕсли;
	СтруктураТовара = Новый Структура;
	СтруктураТовара.Вставить("ЦенаПродажи", Выборка["ЦенаПродажи"]);
	СтруктураТовара.Вставить("ПроцентКомиссии", Выборка["ПроцентКомиссии"]);
	Возврат СтруктураТовара;
КонецФункции
#КонецОбласти